// Rattlesnake Ridge Homestead Hub — Prisma Schema
// SQLite database for local persistent storage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Recipe {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  category    String
  cuisine     String
  emoji       String     @default("🍽️")
  ingredients String     // newline-separated list
  steps       String     // newline-separated list
  source      String     @default("local") // "google" | "local"
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  mealPlans   MealPlan[]
}

model MealPlan {
  id        Int      @id @default(autoincrement())
  weekStart String   // ISO date "YYYY-MM-DD" of the Monday that starts this week
  dayOfWeek Int      // 0=Mon, 1=Tue, 2=Wed, 3=Thu, 4=Fri, 5=Sat, 6=Sun
  slot      String   // "main" | "also"
  recipeId  Int?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weekStart, dayOfWeek, slot])
}
