# =============================================================
# Rattlesnake Ridge Homestead Hub — Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values.
# Windows: copy .env.example .env

# ── Google Docs API ──────────────────────────────────────────
# Absolute path to your Google service account JSON key file.
# Windows example: C:\Users\Sarah\Documents\rr-service-account.json
# Mac/Linux example: /home/sarah/rr-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\your\service-account-key.json

# The Google Doc ID from the URL:
# docs.google.com/document/d/YOUR_DOC_ID/edit  ← copy just that middle part
GOOGLE_DOC_ID=your_google_doc_id_here

# ── Anthropic API ────────────────────────────────────────────
# Get your API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
